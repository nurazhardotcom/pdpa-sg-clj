{
  // Copy this file to your project's .vscode/tasks.json.
  // Requires: pdpa-sg-clj on PATH (or adjust "command" to an absolute bb path).
  // Run via Terminal > Run Task > "pdpa: scan workspace".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pdpa: scan workspace",
      "type": "shell",
      "command": "bb scan --format quickfix ${workspaceFolder}",
      "options": { "cwd": "${workspaceFolder}/pdpa-sg-clj" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": {
        "owner": "pdpa-sg-clj",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): \\[(CRITICAL|HIGH|MEDIUM|LOW)\\] (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "pdpa: audit to SARIF (for SARIF Viewer)",
      "type": "shell",
      "command": "bb audit ${workspaceFolder} --format sarif --out ${workspaceFolder}/audit.sarif",
      "options": { "cwd": "${workspaceFolder}/pdpa-sg-clj" },
      "group": "test",
      "presentation": { "reveal": "silent" },
      "problemMatcher": []
    }
  ]
}
