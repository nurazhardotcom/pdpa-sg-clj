#!/bin/bash
# pre-commit hook — blocks commits containing raw NRICs, SG phones, or secrets
# Install: cp .git/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: bb install-hook

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[pdpa-sg-clj] Scanning staged files for PII...${NC}"

# Get list of staged files (exclude deletions)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}[pdpa-sg-clj] No files to scan.${NC}"
    exit 0
fi

VIOLATIONS=0

for FILE in $STAGED_FILES; do
    # Skip binary files and this hook itself
    case "$FILE" in
        *.png|*.jpg|*.gif|*.ico|*.woff*|*.ttf|*.eot|*.pdf|*.zip|*.tar*|*.gz)
            continue ;;
        .git/hooks/*)
            continue ;;
    esac

    # Skip files that don't exist (deleted)
    [ -f "$FILE" ] || continue

    # Get staged content (not working copy)
    CONTENT=$(git show ":$FILE" 2>/dev/null || true)
    [ -z "$CONTENT" ] && continue

    # Check for valid NRIC/FIN (Mod-11 checksum)
    # Pattern: S/T/F/G/M prefix + 7 digits + letter check digit
    NRIC_HITS=$(echo "$CONTENT" | grep -oP '\b[STFG]\d{7}[A-Z]\b|\bM\d{7}[A-Z]\b' 2>/dev/null || true)
    if [ -n "$NRIC_HITS" ]; then
        for HIT in $NRIC_HITS; do
            # Validate with the Clojure Mod-11 check if bb is available
            if command -v bb &>/dev/null; then
                VALID=$(bb -e "(require '[pdpa.nric :as n]) (println (if (n/valid? \"$HIT\") \"VALID\" \"INVALID\"))" 2>/dev/null || echo "UNKNOWN")
                # Fail-closed: treat UNKNOWN (bb failed) same as VALID
                if [ "$VALID" != "INVALID" ]; then
                    echo -e "${RED}[pdpa-sg-clj] CRITICAL: NRIC found in $FILE: $HIT (checksum: $VALID)${NC}"
                    VIOLATIONS=$((VIOLATIONS + 1))
                fi
            else
                echo -e "${RED}[pdpa-sg-clj] CRITICAL: NRIC pattern found in $FILE: $HIT (install bb for checksum validation)${NC}"
                VIOLATIONS=$((VIOLATIONS + 1))
            fi
        done
    fi

    # Check for SG mobile numbers (8 or 9 digits starting with 8/9)
    PHONE_HITS=$(echo "$CONTENT" | grep -oP '(?:\+65\s?)?[89]\d{7}\b' 2>/dev/null | grep -vE '^\d{8}$|^[89]\d{7}$' || true)
    if [ -n "$PHONE_HITS" ]; then
        for HIT in $PHONE_HITS; do
            echo -e "${RED}[pdpa-sg-clj] HIGH: SG phone number found in $FILE: $HIT${NC}"
            VIOLATIONS=$((VIOLATIONS + 1))
        done
    fi

    # Check for private keys
    if echo "$CONTENT" | grep -qP '-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----'; then
        echo -e "${RED}[pdpa-sg-clj] CRITICAL: Private key found in $FILE${NC}"
        VIOLATIONS=$((VIOLATIONS + 1))
    fi

    # Check for common secret patterns (mirrors pdpa.rules/rule-pack)
    SECRET_PATTERNS=(
        'AKIA[0-9A-Z]{16}'            # AWS Access Key
        'ASIA[0-9A-Z]{16}'            # AWS Session Key
        'ghp_[0-9a-zA-Z]{36}'         # GitHub PAT
        'gho_[0-9a-zA-Z]{36}'         # GitHub OAuth token
        'ghs_[0-9a-zA-Z]{36}'         # GitHub App token
        'github_pat_[0-9a-zA-Z_]{20,}' # GitHub fine-grained PAT
        'glpat-[0-9a-zA-Z\-]{20,}'    # GitLab PAT
        'sk-[0-9a-zA-Z]{32,}'         # OpenAI/Stripe secret key
        'sk-proj-[0-9a-zA-Z_-]{20,}'  # OpenAI project key
        'sk-ant-[0-9a-zA-Z_-]{20,}'   # Anthropic key
        'sk_live_[0-9a-zA-Z]{16,}'    # Stripe live key
        'xox[bpors]-[0-9a-zA-Z\-]+'   # Slack token
        'AIza[0-9A-Za-z_-]{35}'       # Google Cloud API key
        'eyJ[0-9a-zA-Z_-]{10,}\.[0-9a-zA-Z_-]{10,}\.[0-9a-zA-Z_\-=]{10,}' # JWT
        'DefaultEndpointsProtocol=https?;' # Azure connection string
    )

    for PATTERN in "${SECRET_PATTERNS[@]}"; do
        SECRET_HITS=$(echo "$CONTENT" | grep -oP "$PATTERN" 2>/dev/null || true)
        if [ -n "$SECRET_HITS" ]; then
            for HIT in $SECRET_HITS; do
                echo -e "${RED}[pdpa-sg-clj] CRITICAL: Secret token found in $FILE: ${HIT:0:8}...${NC}"
                VIOLATIONS=$((VIOLATIONS + 1))
            done
        fi
    done
done

if [ $VIOLATIONS -gt 0 ]; then
    echo ""
    echo -e "${RED}[pdpa-sg-clj] BLOCKED: $VIOLATIONS PII/secret violation(s) found.${NC}"
    echo -e "${RED}Fix the issues above, or use 'git commit --no-verify' only if you${NC}"
    echo -e "${RED}are certain the data is test/example data.${NC}"
    exit 1
fi

echo -e "${YELLOW}[pdpa-sg-clj] OK — no PII/secret violations found.${NC}"
exit 0
